+import { createClient } from "@/lib/supabase/server";
+
+export async function saveNote(sessionId: string, text: string) {
+  const supabase = await createClient();
+  const { data } = await supabase.auth.getSession();
+  if (!data.session) return { message: "Sign in first." };
+  await supabase.from("session_notes").insert({ session_id: sessionId, text });
+  return { message: "Saved." };
+}
