+"use server";
+import { requireRole } from "@/lib/auth/require-role";
+import { MESSAGES } from "@/lib/scheduling/messages";
+
+// Нотатку пише лише терапевт сеансу: роль — з profiles (getClaims у requireRole), запис — під сесією користувача (RLS).
+export async function saveSessionNote(sessionId: string, text: string) {
+  const { supabase, role } = await requireRole();
+  if (role !== "therapist") return { message: MESSAGES.NOTE_FORBIDDEN };
+  const { error } = await supabase.from("session_notes").insert({ session_id: sessionId, text: text.slice(0, 2000) });
+  if (error) return { message: MESSAGES.NOTE_FAILED };
+  return { message: MESSAGES.NOTE_SAVED };
+}
