+import { describe, expect, it } from "vitest";
+import { saveSessionNote } from "@/app/sessions/[id]/note-actions";
+import { asUser } from "../support/as-user";
+
+describe("нотатка до сеансу", () => {
+  it("AC-NOTE-01: therapist1 зберігає нотатку — «Note saved.»", async () => {
+    await asUser("therapist1@example.test");
+    const result = await saveSessionNote("00000000-0000-4000-8000-000000000001", "Synthetic note.");
+    expect(result.message).toBe("Note saved.");
+  });
+});
