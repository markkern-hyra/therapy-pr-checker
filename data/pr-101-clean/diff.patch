@@ -0,0 +1,17 @@
+-- Нотатка терапевта до сеансу (AC-NOTE-01). Синтетичні дані — лише *@example.test.
+create table public.session_notes (
+  id uuid primary key default gen_random_uuid(),
+  session_id uuid not null,
+  author_id uuid not null default auth.uid() references auth.users (id),
+  text text not null check (char_length(text) <= 2000),
+  created_at timestamptz not null default now()
+);
+
+alter table public.session_notes enable row level security;
+revoke all on public.session_notes from anon, authenticated;
+grant select, insert on public.session_notes to authenticated;
+
+create policy "session_notes: свої нотатки — читання" on public.session_notes
+  for select to authenticated using (author_id = (select auth.uid()));
+create policy "session_notes: свої нотатки — запис" on public.session_notes
+  for insert to authenticated with check (author_id = (select auth.uid()));
